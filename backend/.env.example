NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/paras_prints
FRONTEND_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
# Use a cryptographically random value of at least 32 characters for private integrations.
INTERNAL_API_KEY=
TRUST_PROXY_HOPS=0
API_RATE_LIMIT=1000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFICATION_EMAIL=info@parasprints.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Production uploads require Cloudinary. Private local storage is available only with this explicit flag.
ALLOW_LOCAL_UPLOADS=false
UPLOAD_SESSION_SECRET=
